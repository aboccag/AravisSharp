<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Consumes the AravisSharp .nupkg produced by CI, exactly as a user would, and acquires
    frames from the fake camera. Not part of AravisSharp.slnx: it needs the packed package,
    passed in with -p:AravisSharpVersion=<version> and restored from ../../_packages.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AravisSharp" Version="$(AravisSharpVersion)" />
  </ItemGroup>

</Project>
